# --- Data Directory Structure Protection ---
# Ignore all generated raw and processed data artifacts
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Reference data: preserve directory and allow curated small reference datasets
!data/reference/
!data/reference/.gitkeep

# --- Apache Spark & Sedona Local Artifacts ---
spark-warehouse/
metastore_db/
derby.log

# --- Apache Airflow Local Execution ---
airflow.db
airflow.cfg
webserver_config.py

# --- dbt Build Artifacts ---
target/
dbt_packages/
dbt_modules/

# --- Node / React / Frontend Tooling ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# --- Logs & Telemetry Dumps ---
*.log
logs/
